rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for all uploaded media
    match /uploads/{allPaths=**} {
      allow read: if true;
      // Note: Write access is handled securely via the Next.js API route using the Admin SDK,
      // which bypasses these rules. If you intend to upload directly from the frontend later,
      // you would add RBAC checks here like:
      // allow write: if request.auth != null && request.auth.token.role in ['Media', 'Administrator'];
    }
  }
}
