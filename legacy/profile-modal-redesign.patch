     let currentUserData = null;
     let galleryCache = [];
 
+
+    // ===== PERSISTENT GALLERY STORAGE (FIRESTORE) =====
+    // Render's free filesystem is temporary, so files saved by the backend can disappear
+    // after a restart/redeploy. Store gallery images in Firestore as compressed data URLs
+    // so uploads remain available later.
+    const GALLERY_COLLECTION = 'gallery';
+    const MAX_FIRESTORE_IMAGE_CHARS = 850000;
+
+    function escapeHTML(value) {
+        return String(value || '').replace(/[&<>'"]/g, ch => ({
+            '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
+        }[ch]));
+    }
+
+    function imageFileToPersistentDataUrl(file) {
+        return new Promise((resolve, reject) => {
+            const reader = new FileReader();
+            reader.onerror = () => reject(new Error('Could not read selected image.'));
+            reader.onload = () => {
+                const img = new Image();
+                img.onerror = () => reject(new Error('Could not load selected image.'));
+                img.onload = () => {
+                    const attempts = [
+                        { maxWidth: 1600, quality: 0.78 },
+                        { maxWidth: 1300, quality: 0.70 },
+                        { maxWidth: 1000, quality: 0.64 },
+                        { maxWidth: 800, quality: 0.58 },
+                        { maxWidth: 650, quality: 0.52 }
+                    ];
+
+                    for (const attempt of attempts) {
+                        const scale = Math.min(1, attempt.maxWidth / img.width);
+                        const canvas = document.createElement('canvas');
+                        canvas.width = Math.max(1, Math.round(img.width * scale));
+                        canvas.height = Math.max(1, Math.round(img.height * scale));
+                        const ctx = canvas.getContext('2d');
+                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+                        const dataUrl = canvas.toDataURL('image/jpeg', attempt.quality);
+                        if (dataUrl.length <= MAX_FIRESTORE_IMAGE_CHARS) {
+                            resolve(dataUrl);
+                            return;
+                        }
+                    }
+
+                    reject(new Error('Image is too large to store permanently. Please choose a smaller image.'));
+                };
+                img.src = reader.result;
+            };
+            reader.readAsDataURL(file);
+        });
+    }
+
+    async function getPersistentGalleryItems() {
+        let firestoreItems = [];
+        let backendItems = [];
+
+        try {
+            const snapshot = await db.collection(GALLERY_COLLECTION).orderBy('createdAt', 'desc').get();
+            snapshot.forEach(doc => {
+                const item = doc.data() || {};
+                firestoreItems.push({
+                    id: doc.id,
+                    imageUrl: item.imageUrl,
+                    caption: item.caption || 'Untitled',
+                    createdAt: item.createdAt,
+                    uploadedBy: item.uploadedBy || '',
+                    _source: 'firestore'
+                });
+            });
+        } catch (e) {
+            console.warn('Firestore gallery read failed; falling back to backend only:', e);
+        }
+
+        // Keep old backend photos visible if the Render backend is currently alive.
+        // New uploads use Firestore so they do not vanish after backend restarts.
+        try {
+            const response = await fetch(`${API_BASE_URL}/gallery`);
+            if (response.ok) {
+                const data = await response.json();
+                backendItems = (data || []).map(item => ({ ...item, _source: 'backend' }));
+            }
+        } catch (e) {
+            console.warn('Backend gallery read failed; Firestore items will still be shown:', e);
+        }
+
+        const seen = new Set();
+        return [...firestoreItems, ...backendItems].filter(item => {
+            if (!item || !item.imageUrl) return false;
+            const key = item.imageUrl;
+            if (seen.has(key)) return false;
+            seen.add(key);
+            return true;
+        });
+    }
+
+    async function savePersistentGalleryItem(file, caption) {
+        const imageUrl = await imageFileToPersistentDataUrl(file);
+        const docRef = await db.collection(GALLERY_COLLECTION).add({
+            imageUrl,
+            caption: caption || 'Untitled',
+            uploadedBy: currentUserData?.name || 'Admin',
+            storage: 'firestore-data-url',
+            originalName: file.name || '',
+            createdAt: firebase.firestore.FieldValue.serverTimestamp()
+        });
+        return docRef.id;
+    }
